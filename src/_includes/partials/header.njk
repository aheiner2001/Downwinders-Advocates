{% set L = locale or 'en' %}
{% set t = ui[L] %}
{% set homeHref = '/es/' if L == 'es' else '/' %}
{% set prefix = '/es' if L == 'es' else '' %}
<a class="skip" href="#main">{{ t.skip }}</a>
<header>
  <div class="bar">
    <a class="brand" href="{{ homeHref }}">
      <div class="brand-badge" aria-hidden="true">
        <svg class="shield" viewBox="0 0 60 72">
          <path d="M30 2 56 12v28c0 16-11 25-26 30C15 65 4 56 4 40V12z" fill="#08244A"/>
          <path d="M30 22a9 9 0 0 1 9 9H21a9 9 0 0 1 9-9z" fill="#DEA244"/>
          <path d="M14 40c8-4 12 2 18 0s10-4 14-1" stroke="#FFFFFF" stroke-width="3.2" fill="none" stroke-linecap="round"/>
          <path d="M14 49c8-4 12 2 18 0s10-4 14-1" stroke="#FFFFFF" stroke-width="3.2" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-title">Downwinders Advocates</span>
        <small class="brand-sub">{{ t.brandSubtitle }}</small>
      </div>
    </a>
    <nav aria-label="Main Navigation">
      <a href="{{ homeHref }}">{{ t.home }}</a>
      <a href="{{ prefix }}/check/">{{ t.check }}</a>
      <a href="{{ prefix }}/programs/">{{ t.programs }}</a>
      <a href="{{ prefix }}/pricing/">{{ t.pricing }}</a>
      <a href="{{ prefix }}/become-an-affiliate/">{{ t.affiliate }}</a>
      <a href="{{ prefix }}/about/">{{ t.about }}</a>
      <a href="{{ prefix }}/contact/">{{ t.contact }}</a>
      <div class="nav-phone">
        <span class="phone-label">{{ t.callUsNow }}</span>
        <a class="tel" href="tel:{{ site.phoneTel }}">{{ site.phoneDisplay }}</a>
      </div>
      <a class="lang-switch" href="{{ paths.alternatePath(page.url) }}" hreflang="{% if L == 'es' %}en{% else %}es{% endif %}">{{ t.langSwitchLabel }}</a>
    </nav>
  </div>
</header>
