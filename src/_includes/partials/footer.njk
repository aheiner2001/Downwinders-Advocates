{% set L = locale or 'en' %}
{% set t = ui[L] %}
{% set prefix = '/es' if L == 'es' else '' %}
{% set homeHref = '/es/' if L == 'es' else '/' %}
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <!-- Column 1: Brand & Social -->
      <div class="footer-col footer-brand-col">
        <a class="footer-brand" href="{{ homeHref }}">
          <div class="brand-badge brand-badge--sm" aria-hidden="true">
            <svg class="shield" viewBox="0 0 60 72">
              <path d="M30 2 56 12v28c0 16-11 25-26 30C15 65 4 56 4 40V12z" fill="#08244A"/>
              <path d="M30 22a9 9 0 0 1 9 9H21a9 9 0 0 1 9-9z" fill="#DEA244"/>
              <path d="M14 40c8-4 12 2 18 0s10-4 14-1" stroke="#FFFFFF" stroke-width="3.2" fill="none" stroke-linecap="round"/>
              <path d="M14 49c8-4 12 2 18 0s10-4 14-1" stroke="#FFFFFF" stroke-width="3.2" fill="none" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="footer-brand-title">Downwinders Advocates</span>
        </a>
        <p class="footer-claim">{% if L == 'es' %}Más de 3,000 reclamos presentados y más de 20 años de experiencia{% else %}Filed over 3,000 claims with over 20 years of experience{% endif %}</p>
        <p class="footer-bio">
          {{ 'Ayudamos a personas y familiares sobrevivientes a solicitar el reconocimiento y la compensación federal por enfermedades relacionadas con la exposición a radiación generada por el gobierno.' if L == 'es' else 'Helping individuals and surviving family members receive federal recognition and compensation for illnesses caused by government-created radiation exposure.' }}
        </p>
        <div class="footer-social" aria-label="Social media links">
          {% if site.socialFacebook %}
          <a href="{{ site.socialFacebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95C18.05 21.45 22 17.19 22 12z"/></svg>
          </a>
          {% endif %}
          {% if site.socialX %}
          <a href="{{ site.socialX }}" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          {% endif %}
          {% if site.socialLinkedIn %}
          <a href="{{ site.socialLinkedIn }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.65 1.65 0 0 0-1.66 1.66c0 .91.75 1.66 1.66 1.66 1 0 1.69-.75 1.69-1.66 0-.91-.69-1.66-1.69-1.66z"/></svg>
          </a>
          {% endif %}

        </div>
      </div>

      <!-- Column 2: Programs -->
      <div class="footer-col">
        <h4 class="footer-heading">{{ 'Programas' if L == 'es' else 'Programs' }}</h4>
        <ul class="footer-nav-list">
          <li><a href="{{ prefix }}/programs/"><span class="bullet-arrow">&#9658;</span> {{ 'Resumen de programas' if L == 'es' else 'Programs Overview' }}</a></li>
          <li><a href="{{ prefix }}/programs/#downwinders"><span class="bullet-arrow">&#9658;</span> {{ 'Personas expuestas a lluvia radiactiva' if L == 'es' else 'Downwinders' }}</a></li>
          <li><a href="{{ prefix }}/programs/#onsite"><span class="bullet-arrow">&#9658;</span> {{ 'Participantes en el sitio' if L == 'es' else 'On-Site Participants' }}</a></li>
          <li><a href="{{ prefix }}/programs/#uranium"><span class="bullet-arrow">&#9658;</span> {{ 'Trabajadores del uranio' if L == 'es' else 'Uranium Workers' }}</a></li>
          <li><a href="{{ prefix }}/programs/#manhattan"><span class="bullet-arrow">&#9658;</span> {{ 'Residuos del Proyecto Manhattan' if L == 'es' else 'Manhattan Transfer Waste' }}</a></li>
          <li><a href="{{ prefix }}/check/"><span class="bullet-arrow">&#9658;</span> {{ 'Inicie un reclamo' if L == 'es' else 'File A Claim' }}</a></li>
        </ul>
      </div>

      <!-- Column 3: Menu -->
      <div class="footer-col">
        <h4 class="footer-heading">{{ 'Menú' if L == 'es' else 'Menu' }}</h4>
        <ul class="footer-nav-list">
          <li><a href="{{ homeHref }}"><span class="bullet-arrow">&#9658;</span> {{ 'Inicio' if L == 'es' else 'Home' }}</a></li>
          <li><a href="{{ prefix }}/about/"><span class="bullet-arrow">&#9658;</span> {{ 'Nosotros' if L == 'es' else 'About' }}</a></li>
          <li><a href="{{ prefix }}/programs/"><span class="bullet-arrow">&#9658;</span> {{ 'Programas' if L == 'es' else 'Programs' }}</a></li>
          <li><a href="{{ prefix }}/pricing/"><span class="bullet-arrow">&#9658;</span> {{ 'Precios y honorarios' if L == 'es' else 'Pricing & Fees' }}</a></li>
          <li><a href="{{ prefix }}/become-an-affiliate/"><span class="bullet-arrow">&#9658;</span> {{ 'Sea aliado' if L == 'es' else 'Become an Affiliate' }}</a></li>
          <li><a href="{{ prefix }}/about/#standards"><span class="bullet-arrow">&#9658;</span> {{ 'Nuestros estándares' if L == 'es' else 'Our Standards' }}</a></li>
          <li><a href="{{ prefix }}/about/#faq"><span class="bullet-arrow">&#9658;</span> {{ 'Preguntas frecuentes' if L == 'es' else 'Questions & FAQ' }}</a></li>
          <li><a href="{{ prefix }}/contact/"><span class="bullet-arrow">&#9658;</span> {{ 'Contacto' if L == 'es' else 'Contact' }}</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact Details -->
      <div class="footer-col">
        <h4 class="footer-heading">{{ 'Contacto' if L == 'es' else 'Contact' }}</h4>
        <div class="footer-contact-items">
          {% if site.address %}
          <div class="footer-contact-group"><span class="contact-label">{{ 'Dirección' if L == 'es' else 'Address' }}</span><p>{{ site.address }}</p></div>
          {% endif %}
          <div class="footer-contact-group">
            <span class="contact-label">{{ 'Teléfono' if L == 'es' else 'Phone' }}</span>
            <p><a href="tel:{{ site.phoneTel }}">{{ site.phoneDisplay }}</a></p>
          </div>
          {% if site.faxDisplay %}
          <div class="footer-contact-group"><span class="contact-label">{{ 'Fax' if L == 'es' else 'Fax' }}</span><p>{{ site.faxDisplay }}</p></div>
          {% endif %}
          <div class="footer-contact-group">
            <span class="contact-label">{{ 'Correo' if L == 'es' else 'Email' }}</span>
            <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
          </div>
          <div class="footer-contact-group">
            <span class="contact-label">{{ 'Colaboración legal' if L == 'es' else 'Legal partner' }}</span>
            <p>{{ site.partnerLawFirm }}<br>{{ site.partnerAddress }}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Downwinders Advocates. {{ 'Todos los derechos reservados. En colaboración con' if L == 'es' else 'All rights reserved. In partnership with' }} {{ site.partnerLawFirm }}.</p>
      <div class="footer-bottom-links">
        <a href="{{ prefix }}/about/#standards">{{ 'Estándares' if L == 'es' else 'Standards' }}</a>
        <span class="sep">&middot;</span>
        <a href="{{ prefix }}/contact/">{{ 'Privacidad' if L == 'es' else 'Privacy' }}</a>
        <span class="sep">&middot;</span>
        <a href="{{ prefix }}/contact/">{{ 'Accesibilidad' if L == 'es' else 'Accessibility' }}</a>
      </div>
    </div>
  </div>
</footer>
