{% set L = locale or 'en' %}
{% set t = ui[L] %}
{% set prefix = '/es' if L == 'es' else '' %}
<footer>
  <div class="wrap stack">
    <div class="brand" style="color:#EAF0F7">
      <svg class="shield" viewBox="0 0 60 72" aria-hidden="true">
        <path d="M30 2 56 12v28c0 16-11 25-26 30C15 65 4 56 4 40V12z" fill="#0E2E58"/>
        <path d="M30 24a9 9 0 0 1 9 9H21a9 9 0 0 1 9-9z" fill="#DEA244"/>
        <path d="M14 40c8-4 12 2 18 0s10-4 14-1" stroke="#fff" stroke-width="3.4" fill="none" stroke-linecap="round"/>
        <path d="M14 49c8-4 12 2 18 0s10-4 14-1" stroke="#fff" stroke-width="3.4" fill="none" stroke-linecap="round"/>
      </svg>
      <span>Downwinders Advocates<small>{{ t.footerTagline }}</small></span>
    </div>
    <p class="legal" style="max-width:78ch">{{ t.footerLegal }}</p>
    <p class="legal">
      <a href="{{ prefix }}/check/">{{ t.check }}</a> &nbsp;·&nbsp;
      <a href="{{ prefix }}/free-help/">{{ t.footerFreeHelp }}</a> &nbsp;·&nbsp;
      <a href="{{ prefix }}/standards/">{{ t.footerStandards }}</a>
    </p>
    <p class="legal">{{ site.phoneDisplay }} &nbsp;·&nbsp; {{ site.email }}</p>
  </div>
</footer>
