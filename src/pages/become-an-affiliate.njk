<section class="sec" id="affiliate">
  <div class="wrap stack">
    <div style="text-align:center;max-width:800px;margin:0 auto">
      <p class="eyebrow">Partnership Program</p>
      <h1>Become An Affiliate &amp; Community Partner</h1>
      <p class="lede">We are on a mission to help 100,000 people obtain their $100,000 in federal RECA compensation. Help us reach affected families before the December 31, 2027 deadline.</p>
    </div>

    <!-- Partner Roles Grid -->
    <div class="grid g3" style="margin-top:var(--sp3)">
      <div class="card">
        <h3>Healthcare &amp; Oncology Providers</h3>
        <p class="muted">Physicians, nurses, and oncology social workers treating patients with qualifying cancers who may be unaware of federal compensation rights.</p>
      </div>
      <div class="card">
        <h3>Community &amp; Senior Centers</h3>
        <p class="muted">Local civic leaders, senior center directors, and faith communities in covered counties across Utah, Arizona, Nevada, New Mexico, and Idaho.</p>
      </div>
      <div class="card">
        <h3>Advocates &amp; Family Referrals</h3>
        <p class="muted">Individuals, union representatives, and advocates passionate about helping relatives, neighbors, and colleagues file approved claims.</p>
      </div>
    </div>

    <!-- Referral Intake Form -->
    <div class="form-card" style="max-width:800px;margin:var(--sp4) auto 0;width:100%">
      <h2 style="font-size:24px;color:var(--navy)">Partner With Us or Send a Referral</h2>
      <p class="muted">Tell us about your organization or the individuals you would like to refer. Our partnerships director will connect with you promptly.</p>

      <p class="muted">Tell us about your organization or a potential referral. Reach the team directly by email or phone; please avoid including someone else’s private medical details in your initial message.</p>
      <div class="btns">
        <a class="btn" href="mailto:{{ site.email }}?subject=Partnership%20inquiry">Email About a Partnership</a>
        <a class="btn btn--ghost" href="tel:{{ site.phoneTel }}">Call {{ site.phoneDisplay }}</a>
      </div>
    </div>

    <!-- Contact Direct -->
    <div style="text-align:center;margin-top:var(--sp3)">
      <p class="muted">Prefer to talk directly? Call our partnerships coordinator at <a href="tel:{{ site.phoneTel }}" style="font-weight:700;color:var(--navy)">{{ site.phoneDisplay }}</a> or email <a href="mailto:{{ site.email }}" style="font-weight:700;color:var(--navy)">{{ site.email }}</a>.</p>
    </div>
  </div>
