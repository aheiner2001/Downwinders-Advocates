      <!-- On-Site Participants -->
      <div class="program-card">
        <h3 class="program-card-title">On-Site Participants</h3>
        <div class="program-amount">
          <span class="program-amount-currency">$</span>100,000
        </div>
        <p class="program-desc">For individuals present on-site during above-ground nuclear tests, including military personnel and civilian contractors.</p>
        <div class="program-locations">
          <strong>Presence:</strong> Atmospheric nuclear test sites and proving grounds during designated operational windows.
        </div>
        <a class="btn btn--sm btn--ghost" href="/check/">Check Eligibility</a>
      </div>

      <!-- Uranium Workers -->
      <div class="program-card">
        <h3 class="program-card-title">Uranium Workers</h3>
        <div class="program-amount">
          <span class="program-amount-currency">$</span>100,000
        </div>
        <p class="program-desc">For those who worked in uranium mining, milling, or ore transport. Covers both cancer and chronic nonmalignant lung/renal conditions.</p>
        <div class="program-locations">
          <strong>Coverage:</strong> Miners, millers, and core ore transporters across Western states.
        </div>
        <a class="btn btn--sm btn--ghost" href="/check/">Check Eligibility</a>
      </div>

      <!-- Manhattan Transfer Waste -->
      <div class="program-card">
        <h3 class="program-card-title">Manhattan Transfer Waste</h3>
        <div class="program-amount">
          <span class="program-amount-currency">$</span>50,000
        </div>
        <p class="program-desc">Or reimbursement of medical expenses for residents living near Manhattan Project radioactive storage and processing waste sites.</p>
        <div class="program-locations">
          <strong>Designated Sites:</strong> Qualifying ZIP codes and communities in MO, TN, KY, AK.
        </div>
        <a class="btn btn--sm btn--ghost" href="/check/">Check Eligibility</a>
      </div>
    </div>

    <div style="text-align:center;margin-top:var(--sp2)">
